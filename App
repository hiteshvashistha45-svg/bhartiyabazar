}

function ShopCard({ shop, wished, onWish, onOpen, onAdd }: { shop: Shop; wished: boolean; onWish: () => void; onOpen: () => void; onAdd: (p: Product) => void }) {
  const featured = shop.products.find(p => p.inStock) || shop.products[0];
  return <article className="shop-card"><div className="shop-image-wrap" onClick={onOpen}><img src={shop.photo} alt={shop.name} /><div className="image-top"><span className={shop.isOpen ? "open-badge" : "closed-badge"}>{shop.isOpen ? "● OPEN" : "● CLOSED"}</span>{shop.isTop && <span className="top-badge">TOP SHOP</span>}</div><button className={wished ? "wish-btn wished" : "wish-btn"} onClick={e => { e.stopPropagation(); onWish(); }}>{wished ? "♥" : "♡"}</button></div><div className="shop-card-body"><div className="shop-card-title" onClick={onOpen}><div><h3>{shop.name} <BadgeCheck size={15} className="verified-icon" /></h3><p>{shop.category} · {shop.district}</p></div><span className="rating">★ {shop.rating}</span></div><div className="shop-meta"><span><Clock3 size={14} /> {shop.timing}</span><span><MapPin size={14} /> 1.8 km</span></div><div className="product-strip"><img src={featured.photo} alt="" /><div className="product-info"><b>{featured.name}</b><span>₹{featured.price} / {featured.unit}</span></div><button className="add-mini" disabled={!featured.inStock} onClick={() => onAdd(featured)}><Plus size={17} /></button></div><div className="card-actions"><a href={`tel:+${shop.phone}`}><Phone size={15} /> Call</a><a href={`https://wa.me/${shop.phone}`}><span className="wa-icon">◉</span> WhatsApp</a><button onClick={onOpen}><Compass size={15} /> Direction</button></div></div></article>;
}

