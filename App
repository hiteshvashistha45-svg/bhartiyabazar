function CustomerShell({ children, cartCount = 0 }: { children: React.ReactNode; cartCount?: number }) {
  const [location] = useLocation();
  const [loginOpen, setLoginOpen] = useState(false);
  const nav = [{ href: "/", label: "Home", icon: HomeIcon }, { href: "/wishlist", label: "Wishlist", icon: Heart }, { href: "/referral", label: "Refer & earn", icon: Gift }, { href: "/my-orders", label: "Orders", icon: Package }, { href: "/my-shop", label: "My Shop", icon: Store }];
  return <div className="customer-shell"><header className="topbar"><Brand /><div className="top-actions"><button className="location-chip"><MapPin size={15} /> Jaipur <ChevronRight size={14} /></button><button className="icon-button" onClick={() => setLoginOpen(true)}><UserRound size={20} /></button><Link href="/cart" className="cart-button"><ShoppingCart size={20} />{cartCount > 0 && <b>{cartCount}</b>}</Link></div></header><main className="page-container">{children}</main><nav className="bottom-nav">{nav.map(({ href, label, icon: Icon }) => <Link key={href} href={href} className={location === href ? "active" : ""}><Icon size={20} /><span>{label}</span>{href === "/wishlist" && <i className="nav-dot" />}</Link>)}</nav>{loginOpen && <LoginSheet onClose={() => setLoginOpen(false)} />}</div>;
}

