function WishlistPage() { const ids: string[] = JSON.parse(localStorage.getItem("bb-wishlist") || "[]"); const shops = initialShops.filter(s => ids.includes(s.id)); return <CustomerShell><div className="simple-page"><div className="page-title-row"><div><span className="eyebrow">SAVED FOR LATER</span><h1>Your wishlist</h1></div><Heart size={28} className="orange-icon" fill="currentColor" /></div>{shops.length ? shops.map(s => <ShopCard key={s.id} shop={s} wished onWish={() => {}} onOpen={() => location.assign(`/shop/${s.id}`)} onAdd={() => {}} />) : <div className="empty-state"><span>♡</span><h2>Nothing saved yet</h2><p>Tap the heart on a shop to keep it close.</p><Link href="/" className="primary-btn">Discover local shops</Link></div>}</div></CustomerShell>; }

function OrdersPage() { return <CustomerShell><div className="simple-page"><div className="page-title-row"><div><span className="eyebrow">YOUR SHOPPING</span><h1>My orders</h1></div><Package size={28} className="orange-icon" /></div><div className="order-card"><div className="order-head"><div><span className="order-status">● OUT FOR DELIVERY</span><b>Order #BB-1048</b><small>Shree Ganesh Kirana · Today, 11:42 AM</small></div><strong>₹294</strong></div><div className="timeline"><span className="done"><Check size={12} /></span><i className="done-line" /><span className="done"><Check size={12} /></span><i className="done-line" /><span className="current"><Bike size={13} /></span><i /><span><HomeIcon size={13} /></span></div><div className="timeline-labels"><small>Accepted</small><small>Packed</small><small>On the way</small><small>Delivered</small></div><button className="outline-btn full">Track delivery <ChevronRight size={16} /></button></div></div></CustomerShell>; }

function ShopkeeperPage() { const [open, setOpen] = useState(true); const [commission] = useState(5); const [modal, setModal] = useState(false); return <div className="dashboard-shell shopkeeper-shell"><div className="dashboard-mobile-top"><Brand /><button className="icon-button"><Bell size={20} /></button></div><aside className="dashboard-sidebar"><Brand /><div className="seller-profile"><div className="seller-avatar">RK</div><div><b>Ramesh Kumar</b><small>Shree Ganesh Kirana</small></div><MoreHorizontal size={16} /></div><nav><span className="nav-caption">SHOP MANAGEMENT</span><a className="active"><LayoutDashboard size={18} /> Overview</a><a><ShoppingBag size={18} /> My Products <i>3</i></a><a><Package size={18} /> Orders <b className="red-dot">2</b></a><a href="/my-shop/profile"><Settings size={18} /> Edit Profile</a><span className="nav-caption">ACCOUNT</span><a><WalletCards size={18} /> Payouts</a><a><CircleHelp size={18} /> Help center</a></nav><div className="sidebar-footer"><div className="mini-upgrade"><Sparkles size={17} /><b>Grow faster</b><small>Explore paid promotions</small></div><a href="/">← Back to marketplace</a></div></aside><main className="dashboard-main"><header className="dashboard-header"><div><span className="eyebrow">THURSDAY, 10 SEPTEMBER 2026</span><h1>Good morning, Ramesh <span>👋</span></h1></div><div className="header-right"><span className="notification"><Bell size={19} /><i /></span><div className="profile-circle">RK</div></div></header><section className="shop-status-banner"><div className="status-copy"><span className="eyebrow light">SHOP STATUS</span><h2>Your store is {open ? "open" : "closed"}</h2><p>{open ? "Customers can discover and order from you right now." : "Open your store when you're ready to receive orders."}</p></div><button className={open ? "big-toggle open" : "big-toggle"} onClick={() => setOpen(!open)}><span /><b>{open ? "OPEN" : "CLOSED"}</b></button></section><div className="pending-banner"><Timer size={18} /><span><b>Profile Edit Pending</b><small>Your request is with the admin team. Approval ke baad update hoga.</small></span><a href="/my-shop/profile">View request</a></div><div className="metric-grid"><Metric icon={IndianRupee} label="Today's sales" value="₹8,460" delta="+18.4%" positive /><Metric icon={Package} label="New orders" value="12" delta="4 to accept" /><Metric icon={Users} label="Shop visits" value="248" delta="+12.8%" positive /><Metric icon={TrendingUp} label="Your rating" value="4.8" delta="126 reviews" /></div><div className="dashboard-grid"><div className="dash-card sales-card"><div className="dash-card-head"><div><span className="eyebrow">PERFORMANCE</span><h3>Sales overview</h3></div><select><option>Last 7 days</option><option>Last 30 days</option></select></div><div className="sales-total">₹42,860 <span>+18.4%</span></div><div className="chart-area"><ResponsiveContainer width="100%" height={190}><AreaChart data={salesData}><defs><linearGradient id="greenFill" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" stopColor="#138808" stopOpacity={.3} /><stop offset="100%" stopColor="#138808" stopOpacity={0} /></linearGradient></defs><CartesianGrid vertical={false} stroke="#e8e5df" /><XAxis dataKey="day" axisLine={false} tickLine={false} tick={{ fill: "#88847d", fontSize: 11 }} /><YAxis hide /><Tooltip /><Area type="monotone" dataKey="paid" stroke="#138808" fill="url(#greenFill)" strokeWidth={3} /><Area type="monotone" dataKey="cod" stroke="#FFB400" fill="none" strokeWidth={2} strokeDasharray="5 5" /></AreaChart></ResponsiveContainer></div><div className="legend"><span><i className="green-dot" /> Online UPI</span><span><i className="yellow-dot" /> Cash on delivery</span></div></div><div className="dash-card quick-card"><div className="dash-card-head"><div><span className="eyebrow">QUICK ACTIONS</span><h3>Run your shop</h3></div></div><button onClick={() => setModal(true)}><span className="quick-icon orange"><Plus size={20} /></span><span><b>Add a product</b><small>List something new</small></span><ChevronRight size={17} /></button><button><span className="quick-icon blue"><BarChart3 size={20} /></span><span><b>View analytics</b><small>Understand your customers</small></span><ChevronRight size={17} /></button><button><span className="quick-icon green"><Upload size={20} /></span><span><b>Promote your shop</b><small>Reach more customers</small></span><ChevronRight size={17} /></button><div className="commission-note"><IndianRupee size={16} /><span><b>{commission}% commission</b><small>Only on online UPI orders</small></span></div></div></div><div className="dash-card table-card"><div className="dash-card-head"><div><span className="eyebrow">INVENTORY</span><h3>My products</h3></div><button className="link-btn" onClick={() => setModal(true)}>Manage products <ChevronRight size={16} /></button></div><div className="product-table">{initialShops[0].products.map(p => <div className="product-row" key={p.id}><img src={p.photo} alt="" /><div><b>{p.name}</b><small>₹{p.price} / {p.unit}</small></div><span className={p.stock < 10 ? "low-stock-text" : "stock-green"}>{p.stock} in stock</span><button><MoreHorizontal size={17} /></button></div>)}</div></div></main>{modal && <AddProductModal commission={commission} onClose={() => setModal(false)} />}</div>; }

function Metric({ icon: Icon, label, value, delta, positive }: { icon: any; label: string; value: string; delta: string; positive?: boolean }) { return <div className="metric-card"><div className="metric-icon"><Icon size={18} /></div><span>{label}</span><strong>{value}</strong><small className={positive ? "positive" : ""}>{positive && "↗ "}{delta}</small></div>; }
function AddProductModal({ commission, onClose }: { commission: number; onClose: () => void }) { const [price, setPrice] = useState(""); const payout = price ? calculateCommission(Number(price), commission) : null; return <div className="overlay"><div className="modal-card"><div className="modal-head"><div><span className="eyebrow">INVENTORY</span><h2>Add a product</h2></div><button onClick={onClose}><X size={19} /></button></div><label>Product name <input placeholder="e.g. Aashirvaad Atta 5kg" /></label><div className="two-col"><label>Price (₹)<input value={price} onChange={e => setPrice(e.target.value)} type="number" placeholder="0" /></label><label>MRP (₹)<input type="number" placeholder="0" /></label></div>{payout && <div className="commission-box"><IndianRupee size={18} /><span><b>Online order pe aapko milega: ₹{payout.shopPayout.toFixed(0)}</b><small>₹{payout.commission.toFixed(0)} Bhartiya Bazar commission ({commission}%) · COD pe nahi</small></span></div>}<label>Product photo <div className="upload-box"><Upload size={20} /><span><b>Upload a clear photo</b><small>Gallery or camera · Max 500KB</small></span><input type="file" accept="image/*" /></div></label><div className="modal-actions"><button className="outline-btn" onClick={onClose}>Cancel</button><button className="primary-btn" onClick={() => { toast.success("Product saved"); onClose(); }}>Save product</button></div></div></div>; }

function ProfilePage() { return <div className="dashboard-shell shopkeeper-shell"><div className="dashboard-mobile-top"><Brand /><a href="/my-shop"><ArrowLeft size={20} /></a></div><main className="profile-main"><div className="profile-heading"><a href="/my-shop" className="back-link"><ArrowLeft size={16} /> Back to dashboard</a><span className="eyebrow">SHOP PROFILE</span><h1>Edit your shop profile</h1><p>Changes go live after admin approval.</p></div><div className="profile-form-card"><div className="profile-pending"><Timer size={18} /><span><b>One request is pending review</b><small>Submitted today at 10:24 AM</small></span><span className="pending-tag">PENDING</span></div><div className="form-section"><h3>Basic details</h3><div className="two-col"><label>Shop name<input defaultValue="Shree Ganesh Kirana" /></label><label>Owner name<input defaultValue="Ramesh Kumar" /></label></div><label>Phone number <div className="readonly-input"><Phone size={15} /> +91 98765 43210 <small>READ-ONLY</small></div></label><label>Shop address<textarea defaultValue="18, Vaishali Nagar, Jaipur, Rajasthan 302021" /></label><div className="two-col"><label>State<select defaultValue="Rajasthan"><option>Rajasthan</option><option>Uttar Pradesh</option><option>Madhya Pradesh</option></select></label><label>District<select defaultValue="Jaipur"><option>Jaipur</option><option>Jodhpur</option><option>Udaipur</option></select></label></div></div><div className="form-section"><h3>Category & tax</h3><div className="two-col"><label>Main category<select defaultValue="Kirana & Grocery"><option>Kirana & Grocery</option><option>Fresh Produce</option><option>Pharmacy</option></select></label><label>Sub-category<select><option>Daily Essentials</option><option>Snacks & Beverages</option></select></label></div><label>GST number<input defaultValue="08AABCU9603R1ZV" /></label></div><div className="form-section"><h3>Shop photos <small>Up to 5 photos</small></h3><div className="photo-upload-grid"><div className="main-photo"><img src={initialShops[0].photo} alt="" /><button><Edit3 size={15} /> Change</button></div>{[1, 2, 3, 4].map(i => <button className="photo-add" key={i}><Plus size={20} /><span>Add photo</span></button>)}</div></div><div className="form-section"><h3>Opening hours</h3><div className="hours-row"><label>Open<input type="time" defaultValue="07:00" /></label><span>to</span><label>Close<input type="time" defaultValue="22:00" /></label><label className="checkbox-label"><input type="checkbox" /> Open 24 hours</label></div><label>Weekly off<select><option>Never</option><option>Sunday</option><option>Monday</option></select></label></div><div className="form-footer"><span>Changes will be reviewed by Bhartiya Bazar admin.</span><button className="primary-btn" onClick={() => toast.success("Profile update request admin ko bhej diya gaya hai")}>Save changes <ChevronRight size={16} /></button></div></div></main></div>; }

function AdminPage() { const [tab, setTab] = useState("Overview"); return <div className="admin-shell"><aside className="admin-sidebar"><Brand dark /><div className="admin-badge"><span>ADMIN CONSOLE</span><b>Operations HQ</b></div><nav><a className={tab === "Overview" ? "active" : ""} onClick={() => setTab("Overview")}><LayoutDashboard size={18} /> Overview</a><a><Store size={18} /> Shops <b>24</b></a><a><Users size={18} /> Consumers</a><a><Package size={18} /> Orders</a><a><Tag size={18} /> Categories</a><a className={tab === "Profile Edits" ? "active" : ""} onClick={() => setTab("Profile Edits")}><Edit3 size={18} /> Profile Edits <i>3</i></a><a><BarChart3 size={18} /> Analytics</a></nav><div className="admin-side-bottom"><a><Settings size={18} /> Settings</a><a href="/">↗ View marketplace</a><div className="admin-user"><span>AK</span><div><b>Admin Kumar</b><small>Super admin</small></div></div></div></aside><main className="admin-main"><header className="admin-header"><div className="admin-mobile-menu"><Menu size={22} /></div><div><span className="eyebrow">THURSDAY · 10 SEP 2026</span><h1>{tab === "Profile Edits" ? "Profile edit requests" : "Good morning, Admin"}</h1></div><div className="admin-header-actions"><button className="admin-search"><Search size={17} /> Search anything <kbd>⌘ K</kbd></button><button className="notification dark"><Bell size={19} /><i /></button><span className="admin-avatar">AK</span></div></header>{tab === "Overview" ? <AdminOverview /> : <ProfileEdits />}</main></div>; }
function AdminOverview() { const [commission, setCommission] = useState("5"); const pie = [{ name: "Paid", value: 42, color: "#FF6B00" }, { name: "Free", value: 38, color: "#138808" }, { name: "Pending", value: 20, color: "#F2C94C" }]; return <div className="admin-content"><div className="commission-control"><div><span className="eyebrow light">PLATFORM CONTROL</span><h3>Commission control</h3><p>Applied to online UPI orders across all shops.</p></div><div className="commission-input"><input value={commission} onChange={e => setCommission(e.target.value)} /><span>%</span><button onClick={() => toast.success(`Commission updated to ${commission}%`)}>Save</button></div></div><div className="admin-kpis"><AdminKpi label="Verified shops" value="1,248" change="+8.6%" icon={Store} color="orange" /><AdminKpi label="Active consumers" value="24,860" change="+12.4%" icon={Users} color="blue" /><AdminKpi label="Orders this month" value="8,492" change="+18.1%" icon={Package} color="green" /><AdminKpi label="Platform revenue" value="₹4.28L" change="+22.7%" icon={IndianRupee} color="yellow" /></div><div className="admin-chart-grid"><div className="admin-card wide"><div className="admin-card-head"><div><span className="eyebrow">LIVE SALES</span><h3>Paid vs COD</h3></div><select><option>Last 7 days</option><option>Last 30 days</option></select></div><ResponsiveContainer width="100%" height={240}><LineChart data={salesData}><CartesianGrid vertical={false} stroke="#e8e5df" /><XAxis dataKey="day" axisLine={false} tickLine={false} tick={{ fill: "#8a877f", fontSize: 11 }} /><YAxis axisLine={false} tickLine={false} tick={{ fill: "#8a877f", fontSize: 11 }} tickFormatter={v => `₹${v / 1000}k`} /><Tooltip /><Line type="monotone" dataKey="paid" name="Paid" stroke="#138808" strokeWidth={3} dot={false} /><Line type="monotone" dataKey="cod" name="COD" stroke="#FFCC00" strokeWidth={3} dot={false} /></LineChart></ResponsiveContainer></div><div className="admin-card"><div className="admin-card-head"><div><span className="eyebrow">SUBSCRIPTION</span><h3>Paid vs free</h3></div><MoreHorizontal size={18} /></div><div className="pie-wrap"><ResponsiveContainer width="48%" height={160}><PieChart><Pie data={pie} dataKey="value" innerRadius={48} outerRadius={70} paddingAngle={3}>{pie.map(x => <Cell key={x.name} fill={x.color} />)}</Pie></PieChart></ResponsiveContainer><div className="pie-legend">{pie.map(x => <span key={x.name}><i style={{ background: x.color }} />{x.name}<b>{x.value}%</b></span>)}</div></div></div><div className="admin-card wide"><div className="admin-card-head"><div><span className="eyebrow">COMMISSION</span><h3>Top districts</h3></div><span className="chart-note">At {commission}% platform rate</span></div><ResponsiveContainer width="100%" height={210}><BarChart data={districtData} layout="vertical"><CartesianGrid horizontal={false} stroke="#e8e5df" /><XAxis type="number" hide /><YAxis type="category" dataKey="district" axisLine={false} tickLine={false} width={60} tick={{ fill: "#64615b", fontSize: 11 }} /><Tooltip /><Bar dataKey="commission" fill="#FF6B00" radius={[0, 5, 5, 0]} barSize={18} /></BarChart></ResponsiveContainer></div><div className="admin-card wide"><div className="admin-card-head"><div><span className="eyebrow">ALL INDIA REPORT</span><h3>Zila wise report</h3></div><span className="chart-note">Top districts by activity</span></div><ResponsiveContainer width="100%" height={210}><BarChart data={zilaData}><CartesianGrid vertical={false} stroke="#e8e5df" /><XAxis dataKey="district" axisLine={false} tickLine={false} tick={{ fill: "#64615b", fontSize: 11 }} /><YAxis axisLine={false} tickLine={false} tick={{ fill: "#8a877f", fontSize: 11 }} /><Tooltip /><Bar dataKey="consumers" name="Consumers" fill="#3B82F6" radius={[5, 5, 0, 0]} /><Bar dataKey="shops" name="Shops" fill="#FF6B00" radius={[5, 5, 0, 0]} /></BarChart></ResponsiveContainer></div></div><div className="admin-bottom-grid"><div className="admin-card"><div className="admin-card-head"><div><span className="eyebrow">NEEDS ATTENTION</span><h3>Pending shops</h3></div><button className="link-btn">View all <ChevronRight size={15} /></button></div>{["Narmada General Store", "Shivam Electronics", "Meera Fashion House"].map((x, i) => <div className="attention-row" key={x}><span className="pending-avatar">{x[0]}</span><div><b>{x}</b><small>{["Bhopal", "Surat", "Udaipur"][i]} · Applied {i + 1}h ago</small></div><button className="approve-btn">Review</button></div>)}</div><div className="admin-card profile-alert"><div className="alert-icon"><Edit3 size={20} /></div><div><span className="eyebrow">PROFILE EDITS</span><h3>3 requests need review</h3><p>Shopkeepers are waiting for profile updates to be approved.</p><button onClick={() => location.assign("/admin?tab=edits")}>Open requests <ChevronRight size={15} /></button></div></div></div></div>; }
function AdminKpi({ label, value, change, icon: Icon, color }: any) { return <div className="admin-kpi"><span className={`kpi-icon ${color}`}><Icon size={18} /></span><small>{label}</small><b>{value}</b><span className="kpi-change">↗ {change}</span></div>; }
function ProfileEdits() { const edits = [{ name: "Ramesh Kumar", shop: "Shree Ganesh Kirana", district: "Jaipur", time: "12 min ago" }, { name: "Sunita Devi", shop: "Maa Ganga Fresh Mart", district: "Lucknow", time: "1 hour ago" }, { name: "Amit Sharma", shop: "Swasthya Medical Hall", district: "Indore", time: "3 hours ago" }]; return <div className="admin-content"><div className="edits-intro"><div><span className="eyebrow">REVIEW QUEUE</span><h2>3 pending requests</h2><p>Compare the old and new details before approving.</p></div><button className="outline-btn">Export CSV</button></div><div className="edits-table">{edits.map(e => <div className="edit-row" key={e.shop}><div className="edit-shop"><span className="pending-avatar">{e.shop[0]}</span><span><b>{e.shop}</b><small>{e.name}</small></span></div><span>{e.district}</span><span className="time-ago">{e.time}</span><div className="diff-preview"><small>SHOP NAME</small><span>{e.shop}</span><em>New photo + timing update</em></div><div className="edit-actions"><button className="reject-btn" onClick={() => toast("Request marked for rejection")}>Reject</button><button className="approve-btn filled" onClick={() => toast.success(`${e.shop} profile approved`)}>Approve <Check size={14} /></button></div></div>)}</div></div>; }

function App() { useEffect(() => { const ref = new URLSearchParams(window.location.search).get("ref")?.trim().toUpperCase(); if (ref) localStorage.setItem("bb-referral-code", ref); }, []); return <ThemeProvider defaultTheme="light"><TooltipProvider><Toaster /><Switch><Route path="/" component={HomePage} /><Route path="/shop/:id">{params => <ShopPage id={params.id} />}</Route><Route path="/cart" component={CartPage} /><Route path="/checkout" component={CheckoutPage} /><Route path="/wishlist" component={WishlistPage} /><Route path="/referral" component={ReferralPage} /><Route path="/my-orders" component={OrdersPage} /><Route path="/my-shop/profile" component={ProfilePage} /><Route path="/my-shop" component={ShopkeeperPage} /><Route path="/admin" component={AdminPage} /><Route><HomePage /></Route></Switch></TooltipProvider></ThemeProvider>; }

export default App;
